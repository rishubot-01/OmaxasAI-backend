# ==========================================
# OMAXAS AI BD - Environment Configuration
# ==========================================

# Django Core Settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver


# ==========================================
# Database
# ==========================================

# Use sqlite for local development.
# Use postgres when PostgreSQL is configured.
DB_ENGINE=sqlite

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432


# ==========================================
# Frontend CORS and CSRF
# ==========================================

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ==========================================
# Email Configuration
# ==========================================

# Development: print emails in the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com


# ==========================================
# AI Provider API Keys
# Add keys only for providers you plan to use.
# ==========================================

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
PERPLEXITY_API_KEY=
HUGGINGFACE_API_KEY=


# ==========================================
# Web Search
# ==========================================

TAVILY_API_KEY=


# ==========================================
# Self-Hosted AI Model
# Configure these only when using your own
# model-serving endpoint.
# ==========================================

SELF_HOSTED_MODEL_BASE_URL=http://127.0.0.1:8001/v1
SELF_HOSTED_MODEL_API_KEY=
SELF_HOSTED_MODEL_NAME=omaxasai-local


# ==========================================
# Image Generation
# Configure according to the image provider
# implemented in the project.
# ==========================================

IMAGE_PROVIDER_API_KEY=